<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Sobrepor a outros apps": no Android 10+ abrir uma tela a partir do boot é BLOQUEADO por
         padrão (background activity start). Esta permissão é a isenção oficial. Sem ela, o
         auto-start falhava em silêncio justamente nos aparelhos mais novos. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Auto-update: instalar um APK baixado (não da Play Store) exige esta permissão desde o
         Android 8. O usuário concede na tela de Configurações que o próprio Android abre ao
         tentar instalar sem ela — não dá pra conceder por código, só pedir. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Roda em qualquer Android: TV (sem touch, com controle) e celular/tablet (com touch). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.DSView">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <!-- Launcher normal (celular/tablet) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher de Android TV (leanback) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Pode ser definido como TELA INICIAL do aparelho. É o auto-start à prova de bala:
                 o sistema SEMPRE abre a tela inicial ao ligar, sem depender de permissão nem de
                 receiver. O usuário escolhe no diálogo do Android; dá para voltar atrás nas
                 configurações de apps padrão. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Auto-start no boot (opcional, ligado no setup). `exported="true"` é obrigatório pro
             sistema conseguir entregar BOOT_COMPLETED (broadcast protegido — nenhum outro app
             consegue forjar). As ações QUICKBOOT_POWERON, porém, NÃO são protegidas: qualquer app
             pode mandar uma e forçar o MainActivity a abrir. Mantidas mesmo assim porque caixas
             Amlogic/MediaTek de verdade não mandam BOOT_COMPLETED (gotcha já documentado) — o pior
             caso do risco residual é outro app relançar o kiosk, não vazar dado nenhum.
             ponytail: risco aceito, upgrade se algum cliente reportar abuso de verdade. -->
        <!-- Compartilha o APK baixado (cache do app) com o instalador do sistema. Desde o Android 7,
             um file:// cru entre apps é bloqueado (FileUriExposedException) — precisa de content://
             via FileProvider, autoridade única por pacote pra não colidir com outros apps instalados. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- Volta a tocar sozinho depois de atualizar o app. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
