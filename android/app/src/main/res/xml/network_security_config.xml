<?xml version="1.0" encoding="utf-8"?>
<!-- Permite HTTP em claro só para o servidor local (cache-proxy em 127.0.0.1). Resto continua exigindo HTTPS.
     base-config: minSdk 21 (Android 5.0) mira TV box velho/barato, cujo trust store de fábrica muitas vezes
     não tem a ISRG Root X1 (raiz atual da Let's Encrypt desde que a DST Root CA X3 expirou em 09/2021) —
     causa real de "Trust anchor for certification path not found" reportado por cliente num TV box (o
     aparelho de teste, mais novo/atualizado, não reproduz). Como o app é white-label (fala HTTPS com o
     WordPress de QUALQUER cliente, normal em cPanel com Let's Encrypt de graça), não dá pra fixar um
     domínio só — a raiz vai embutida no APK e soma ao trust store do sistema, sem substituí-lo. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrgrootx1" />
        </trust-anchors>
    </base-config>
</network-security-config>
